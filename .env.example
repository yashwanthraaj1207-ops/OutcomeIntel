# ==============================================================================
# OutcomeIntel - Google Gemini AI Configuration
# ==============================================================================
# In Vercel Production:
#   Add GEMINI_API_KEY under: Project Settings -> Environment Variables
#   Target: Production, Preview, Development
#
# In Local Development:
#   Copy this file to .env and insert your personal Gemini API Key
# ==============================================================================

# Server-Side Gemini API Key (Secure - never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (Fast, low-latency, high accuracy)
GEMINI_MODEL=gemini-2.5-flash-lite

# (Optional) Client-Side Development Override (DO NOT USE IN PRODUCTION)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_MODEL=gemini-2.5-flash-lite
